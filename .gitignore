# Python artifacts
__pycache__
*.egg-info

# ML stuff
#/data
/logs
/checkpoints
wandb
.hydra
outputs
multirun
lightning_logs
*.pickle
.ipynb_checkpoints/

# model weights / checkpoints (results/**/model_checkpoint/ holds ~6GB of these;
# the small loss.csv curves next to them stay tracked)
*.pt
*.pth
*.ckpt
*.safetensors

# run pickles: normalizers, eval_result, node_type_to_X_syn (~1.7GB). The label
# encoders under data/ are deliberately NOT matched — the datasets need them.
results/**/*.pkl

# full database dumps written by every run (~5.5GB, single CSVs up to 113MB —
# over GitHub's 100MB limit); rerun main.py to regenerate
results/**/synthetic_database/
results/**/real_database/
results/**/sampled_structure/

# run-scaffolding symlinks to absolute local paths (dangling in any other clone)
results/stage2/*/*/configs
results/stage2/*/*/data
results/stage2/*/*/rdbdiff_workspace/
results/stage2/d5/workspace

*.log

# project-specific
/rdbdiff_workspace
/seml

# local datasets: `preprocessed` symlinks into the ClavaDDPM checkout, splits are
# regenerated by downstream/make_berka_split.py (~120MB of CSVs)
/data/berka
/data/ccs

# sweep runtime state
/sweep/.lock
/sweep/.complete
/sweep/state/

# third-party reference papers/reports
/docs/references/
/Amex reports/

# tooling
.code-review-graph/
graphify-out/
